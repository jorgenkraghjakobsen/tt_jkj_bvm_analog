# ============================================================
# depend.config -- bandgap
#
# Format note: this is a reading of the IC Works convention, not a
# transcription of it. Align the key names with the mentor's real
# template in week 1; scripts/workspace.py parses what is here.
# ============================================================

NAME       = bandgap
DOMAIN     = analog
OWNER      =
STATUS     = netlist
# STATUS one of: none netlist schematic layout lvs-clean signed-off

DEPENDS    = dig_top
PROVIDES   = VREF bias_ok

SIM        = spice/tb_sc_ideal.spice spice/tb_sc_ota.spice spice/tb_pnp_char.spice
CONSUMES   = phi1 phi2 cap i8_en ota_en bg_en bg_trim[3:0]
FALLBACK   = fallback/spice/simple_ref.spice
AREA_BUDGET= 80 x 90 um
NOTE       = Has its own bias core and start-up: it cannot take current
NOTE       = from bias_gen, because bias_gen depends on VREF.
