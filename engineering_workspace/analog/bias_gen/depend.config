# ============================================================
# depend.config -- bias_gen
#
# Format note: this is a reading of the IC Works convention, not a
# transcription of it. Align the key names with the mentor's real
# template in week 1; scripts/workspace.py parses what is here.
# ============================================================

NAME       = bias_gen
DOMAIN     = analog
OWNER      =
STATUS     = netlist
# STATUS one of: none netlist schematic layout lvs-clean signed-off

DEPENDS    = bandgap
PROVIDES   = IBIAS nbias pbias

SIM        = spice/tb_bias_gen.spice
CONSUMES   = VREF bias_en bias_trim[4:0]
NOTE       = VREF drives a gate only. 5-bit binary-weighted mirror,
NOTE       = 1-32 uA, weighted by device count not device width.
