# ============================================================
# depend.config -- out_buf
#
# Format note: this is a reading of the IC Works convention, not a
# transcription of it. Align the key names with the mentor's real
# template in week 1; scripts/workspace.py parses what is here.
# ============================================================

NAME       = out_buf
DOMAIN     = analog
OWNER      =
STATUS     = netlist
# STATUS one of: none netlist schematic layout lvs-clean signed-off

DEPENDS    = bias_gen
PROVIDES   = out_buf.spice

SIM        = spice/tb_out_buf.spice
CONSUMES   = IBIAS
INSTANCES  = 2 (VREF -> ua[0], and inside pwm_dac -> ua[2])
NOTE       = NMOS input pair cannot follow its input to ground. Either
NOTE       = restrict the DAC swing to ~0.7-1.6 V or make the input
NOTE       = stage complementary. Decide before layout.
