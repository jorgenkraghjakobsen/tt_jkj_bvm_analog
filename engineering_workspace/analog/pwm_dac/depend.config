# ============================================================
# depend.config -- pwm_dac
#
# Format note: this is a reading of the IC Works convention, not a
# transcription of it. Align the key names with the mentor's real
# template in week 1; scripts/workspace.py parses what is here.
# ============================================================

NAME       = pwm_dac
DOMAIN     = analog
OWNER      =
STATUS     = descoped
# STATUS one of: descoped none rtl netlist schematic layout
#                lvs-clean signed-off

DEPENDS    = out_buf bias_gen
PROVIDES   = ua[2]

SIM        = spice/tb_pwm_dac.spice
CONSUMES   = PWM0 IBIAS
NOTE       = Two-stage RC. 6-bit at 100 MHz needs ~1 pF + ~2 Mohm per
NOTE       = stage (~1000 um2). The 8-bit/50 MHz option needs ~10 pF
NOTE       = per stage, about 28 % of a 1x2 tile, and does not fit.
NOTE       =
NOTE       = DESCOPED 2026-11-14 for shuttle TTSKY26d. The netlist is
NOTE       = verified and stays in the tree for a future shuttle; it is
NOTE       = simply not being laid out. Layout was 13-20 days of work
NOTE       = against 16 available with nothing drawn, so pwm_dac and
NOTE       = clk_doubler were cut together -- the DAC's 1.44 mV ripple
NOTE       = depends on the doubled 1.5625 MHz clock, and at the core
NOTE       = clock it degrades to ~5.8 mV, 83 % of an LSB.
