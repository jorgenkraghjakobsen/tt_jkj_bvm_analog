# ============================================================
# depend.config -- dig_top
#
# Format note: this is a reading of the IC Works convention, not a
# transcription of it. Align the key names with the mentor's real
# template in week 1; scripts/workspace.py parses what is here.
# ============================================================

NAME       = dig_top
DOMAIN     = digital
OWNER      =
STATUS     = lvs-clean
# STATUS one of: none netlist schematic layout lvs-clean signed-off

DEPENDS    = spi_slave reg_bank pwm
PROVIDES   = dig_top.v bg_seq.v dig_top.gds dig_top.lef

SIM        = tb/test_dig_top.py tb/test_bg_seq.py tb/test_bg_seq_rules.py
HARDEN     = setup/digital/librelane/config.json
NOTE       = bg_seq rev2: cap now opens before phi2 ends. See
NOTE       = analog/bandgap/doc/BANDGAP_NOTES.md section 1.
NOTE       =
NOTE       = Hardened 2026-11-14 with LibreLane: 80/80 stages, netgen
NOTE       = LVS "circuits match uniquely", DRC and antenna clean.
NOTE       = 8012.7 um2 of cells in a 190 x 130 die (~47 % util).
NOTE       = Views in macro/dig_top/. Signed off against dig_top.sdc
NOTE       = (3 clocks) -- earlier runs used a generic fallback SDC
NOTE       = because PNR_SDC_FILE was never set.
