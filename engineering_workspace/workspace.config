# ============================================================
# workspace.config -- components in this project
#
# One line per component. Each named directory holds its own
# depend.config. scripts/workspace.py reads this file, follows the
# depend.config files, checks the dependency graph and prints a
# build order.
#
#   python3 scripts/workspace.py            status table + build order
#   python3 scripts/workspace.py --graph    dependency graph
#   python3 scripts/workspace.py --check    non-zero exit on a problem
# ============================================================

PROJECT_NAME = bvm_analog_tapeout
VERSION      = 2026-11-14n   # scope cut to 4 analog blocks; macro hardened
PDK          = sky130A
SHUTTLE      = TTSKY26d
DEADLINE     = 2026-11-30
TOP          = analog/tt_analog_top

# ---- digital ------------------------------------------------
COMPONENT = digital/spi_slave
COMPONENT = digital/reg_bank
COMPONENT = digital/pwm
COMPONENT = digital/dig_top

# ---- analog -------------------------------------------------
COMPONENT = analog/bandgap
COMPONENT = analog/bias_gen
COMPONENT = analog/clk_doubler   # DESCOPED for TTSKY26d
COMPONENT = analog/out_buf
COMPONENT = analog/pwm_dac       # DESCOPED for TTSKY26d
COMPONENT = analog/tt_analog_top

# ---- roots --------------------------------------------------
SETUP_ROOT   = setup
TAPEOUT_ROOT = tapeout
BUILD_ROOT   = obj
DOC_ROOT     = doc
